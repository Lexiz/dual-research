<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DS · {{pane_name}} (verbatim from Design System v2.html {{ds_label}})</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,600;8..144,700&family=Roboto+Serif:opsz,wght@8..144,400;8..144,500;8..144,600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined" rel="stylesheet" />

  <!-- The exact stylesheets the Design System v2.html page loads. -->
  {{ds_css_links}}

  <style>
    /* Material Symbols base, copied from Design System v2.html. */
    .ms { font-family: 'Material Symbols Outlined'; font-weight: 400; font-style: normal; font-size: 20px; line-height: 1; vertical-align: middle; user-select: none; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .ms-24 { font-size: 24px; }
    .ms-20 { font-size: 20px; }
    .ms-18 { font-size: 18px; }

    .ds-section:first-of-type { margin-top: var(--md-sp-8); }

    .__src {
      position: sticky; top: 0; z-index: 50;
      padding: 8px 14px;
      background: var(--md-surface-container);
      border-bottom: 1px solid var(--md-outline-hair);
      font: 500 11px/1 var(--md-font-data);
      color: var(--md-on-surface-variant);
    }

    body { background: var(--md-surface, #0f1115); color: var(--md-on-surface, #d9dee5); margin: 0; padding: 0; font-family: var(--md-font-plain, system-ui, sans-serif); }
  </style>
</head>
<body class="dark">
  <div class="__src">DS extract · {{pane_name}} · {{ds_label}} · {{date}}</div>
  <main class="ds-page">
{{ds_sections}}
  </main>
</body>
</html>
