__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Run artifacts — large, regenerable, not source of truth
runs/

# Spec-queue runtime state — local scratch; the queue rebuilds it from
# specs/, gh, and on-disk handoffs/. Only the .gitkeep marker is tracked
# so the directory exists in fresh clones.
queue/*
!queue/.gitkeep

# Spec 0048 — reconcile snapshots are regenerated by the daily cron and
# persisted to Supabase; local copies are scratch.
reconcile/

# Local-only
.env
.env.local
*.log
.DS_Store

# Per-developer harness config (Claude Code preview launch settings)
# Ignore everything in .claude/ EXCEPT project-versioned skills under
# .claude/skills/ (spec 0032). Git's gitignore semantics require the
# parent directory itself to NOT be blanket-ignored before child
# negations work — hence the `.claude/*` glob plus per-child exceptions.
.claude/*
!.claude/skills/
!.claude/skills/**
supabase/.temp/

# Spec 0160 — Cloudflare Pages Function local-dev secrets. Holds
# GITHUB_TOKEN for `npx wrangler pages dev dist`. Never commit.
.dev.vars

# Spec 0161 — JS test stack devDependencies tree. Installed locally on
# opt-in via `make test-js`; never committed.
node_modules/
package-lock.json
